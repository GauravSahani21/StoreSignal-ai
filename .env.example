# StoreSignal AI - Environment Variables Template
# Copy to .env for local development

# Runtime Environment
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://storesignal:storesignal_dev_pwd@localhost:5432/storesignal_dev

# LLM Gateway Configuration - Groq API (Primary Ultra-Fast LPU)
# Set your Groq API key (starts with gsk_)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# LLM Gateway Configuration - NVIDIA NIM API (Alternative)
# Required for live AI agent operations. Set your NVIDIA API key (starts with nvapi-)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# LLM Gateway Configuration - OpenRouter (Alternative)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_TIMEOUT_MS=30000

# Optional test flags
# RUN_LIVE_TESTS=1
